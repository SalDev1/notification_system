
logging {
  level  = "info"
  format = "logfmt"
}

// Discover containers running in Docker.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

// Convert Docker container names into useful log labels.
discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// Read logs from the discovered containers.
loki.source.docker "container_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  labels     = { job = "docker" }
  relabel_rules = discovery.relabel.container_logs.rules
  forward_to = [loki.write.local.receiver]
}

// Send collected logs to Loki.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}